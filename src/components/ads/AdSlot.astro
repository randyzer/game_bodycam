---
import { buildThirdPartyScriptConfig } from "../../core/third-party-scripts";

interface Props {
  placement: "home-primary" | "before-footer";
  label?: string;
  enabled?: boolean;
}

const { placement, label = "Advertisement", enabled = true } = Astro.props;
const ad = enabled
  ? buildThirdPartyScriptConfig({
      PUBLIC_ADSTERRA_AD_KEY: import.meta.env.PUBLIC_ADSTERRA_AD_KEY,
      PUBLIC_ADSTERRA_BASE_URL: import.meta.env.PUBLIC_ADSTERRA_BASE_URL,
    })
  : undefined;
---

{ad?.adsterraScriptSrc && ad.adsterraContainerId && (
  <aside
    class:list={["site-ad", `site-ad--${placement}`]}
    aria-label={label}
    data-ad-placement={placement}
    data-pagefind-ignore
  >
    <div class="shell site-ad__inner">
      <p class="site-ad__label" aria-hidden="true">{label}</p>
      <script
        is:inline
        async="async"
        data-cfasync="false"
        src={ad.adsterraScriptSrc}
      />
      <div class="site-ad__container" id={ad.adsterraContainerId} />
    </div>
  </aside>
)}
