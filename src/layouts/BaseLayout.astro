---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { siteConfig } from "../core/site-data";
import {
  buildBaseSeoGraph,
  buildCanonicalUrl,
  serializeJsonLd,
  type StructuredDataNode,
} from "../core/seo";
import type { PageInventoryEntry } from "../data/schemas/page-inventory";
import { buildThirdPartyScriptConfig } from "../core/third-party-scripts";
import "../styles/global.css";

interface Props {
  page: PageInventoryEntry;
  structuredData?: StructuredDataNode | StructuredDataNode[];
}

const { page, structuredData } = Astro.props;
const canonical = buildCanonicalUrl(siteConfig, page.route);
const robots =
  page.indexability === "index"
    ? "index, follow, max-image-preview:large"
    : "noindex, nofollow";
const graph = [
  ...buildBaseSeoGraph(siteConfig, page),
  ...(Array.isArray(structuredData)
    ? structuredData
    : structuredData
      ? [structuredData]
      : []),
];
const thirdPartyScripts = buildThirdPartyScriptConfig({
  PUBLIC_ADSTERRA_AD_KEY: import.meta.env.PUBLIC_ADSTERRA_AD_KEY,
  PUBLIC_ADSTERRA_BASE_URL: import.meta.env.PUBLIC_ADSTERRA_BASE_URL,
  PUBLIC_GA_MEASUREMENT_ID: import.meta.env.PUBLIC_GA_MEASUREMENT_ID,
});
---

<!doctype html>
<html lang={siteConfig.site.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robots} />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.brand.name} />
    <meta property="og:locale" content={siteConfig.site.locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={page.title} />
    <meta name="twitter:description" content={page.description} />
    {siteConfig.social.xHandle && (
      <meta name="twitter:site" content={siteConfig.social.xHandle} />
    )}

    <script
      is:inline
      type="application/ld+json"
      set:html={serializeJsonLd({
        "@context": "https://schema.org",
        "@graph": graph,
      })}
    />
    {thirdPartyScripts.googleAnalyticsScriptSrc && (
      <script is:inline async src={thirdPartyScripts.googleAnalyticsScriptSrc}></script>
    )}
    {thirdPartyScripts.googleAnalyticsInlineConfig && (
      <script is:inline set:html={thirdPartyScripts.googleAnalyticsInlineConfig}></script>
    )}
  </head>
  <body id="top" data-page-family={page.module}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header currentRoute={page.route} />
    <slot />
    <Footer />
    {thirdPartyScripts.adsterraScriptSrc && (
      <script is:inline async="async" data-cfasync="false" src={thirdPartyScripts.adsterraScriptSrc}></script>
    )}
    {thirdPartyScripts.adsterraContainerId && (
      <div id={thirdPartyScripts.adsterraContainerId}></div>
    )}
  </body>
</html>
